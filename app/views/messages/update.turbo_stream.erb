<!-- 19. This template is rendered when a message is updated with Turbo -->
<!-- It tells the browser to replace the existing message with the updated one -->
<%= turbo_stream.replace @message do %>
  <%= render @message %>
<% end %>

<!-- 20. Update the notice to show a success message -->
<%= turbo_stream.update "notice" do %>
  <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block">
    Message was successfully updated.
  </p>
<% end %> 