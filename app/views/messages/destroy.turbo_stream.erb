<!-- 21. This template is rendered when a message is deleted with Turbo -->
<!-- It tells the browser to remove the message element from the DOM -->
<%= turbo_stream.remove @message %>

<!-- 22. Update the notice to show a success message -->
<%= turbo_stream.update "notice" do %>
  <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block">
    Message was successfully deleted.
  </p>
<% end %> 